; Engine configuration file.
; Shadow Chess 3D — Godot 4.7
config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Shadow Chess 3D"
config/name_localized={
}
config/description="A premium desktop 3D chess game for Linux."
config/version="2.0.0"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/auto_accept_quit=true
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SettingsStore="*res://scripts/save/settings_store.gd"
GameSession="*res://scripts/game/game_session.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"

[debug]

file_logging/enable_file_logging.pc=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/min_width=1100
window/size/min_height=700
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

common/snap_controls_to_pixels=true

[input]

orbit={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":2,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}
