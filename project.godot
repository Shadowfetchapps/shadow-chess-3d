[layer_names]

3d_physics/layer_1="board"
3d_physics/layer_2="pieces"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
environment/defaults/default_clear_color=Color(0.012, 0.01, 0.008, 1)
environment/ssao/quality=3
environment/screen_space_reflection/roughness_quality=2
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
reflections/sky_reflections/roughness_layers=8
