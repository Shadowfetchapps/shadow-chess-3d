; Engine configuration file.
; Shadow Chess 3D — Godot 4.7
config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Shadow Chess 3D"
config/name_localized={
}
config/description="A flagship 3D chess game for Linux: a private salon, a strong threaded engine, puzzles, and analysis."
config/version="3.0.0"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/auto_accept_quit=true
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.017, 0.013, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/icons/shadow-chess-3d.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/icon="res://icon.svg"

[autoload]

SettingsStore="*res://scripts/save/settings_store.gd"
ProfileStore="*res://scripts/save/profile_store.gd"
GameSession="*res://scripts/game/game_session.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"

[debug]

file_logging/enable_file_logging.pc=false
gdscript/warnings/unused_parameter=0
gdscript/warnings/untyped_declaration=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/min_width=1100
window/size/min_height=680
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

common/snap_controls_to_pixels=true
timers/tooltip_delay_sec=0.35

